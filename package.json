{
  "name": "frontrangeliving",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run search:index",
    "search:index": "pagefind --site out --output-subdir pagefind",
    "start": "npx --yes serve out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,mdx,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,mdx,json,yml}\"",
    "content": "velite build",
    "content:watch": "velite dev",
    "new": "node scripts/new-doc.mjs",
    "check": "npm-run-all --parallel typecheck lint format:check"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "schema-dts": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "velite": "^0.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "github-slugger": "^2.0.0",
    "npm-run-all": "^4.1.5",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-smartypants": "^3.0.3",
    "shiki": "^4.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.0"
  }
}
